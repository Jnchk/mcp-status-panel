# status-panel configuration, read from the working directory or beside the exe.
gateway_url=http://<host>:8930/status
gateway_token=<token from opencode cli.json mcp-gateway-status plugin>
opencode_url=https://<host>:10240/api/experimental/session/stats?tools=none&timezone=Asia/Shanghai
opencode_user=opencode
opencode_password=<OPENCODE_PASSWORD from serve.env>
# true skips certificate verification, needed when the LAN host uses a self-signed CA
tls_insecure=false
# GitHub releases feed used for the "latest v2" line
releases_url=https://api.github.com/repos/anomalyco/opencode/releases?per_page=40
always_on_top=true
# any font file name found in the system font directory; Consolas on Windows
font=Consolas
# tray icon; closing the window hides instead of quitting, Quit is in the tray menu
tray=true
# show the app button in the Windows taskbar
taskbar=false
# blocks, one group of keys each; unknown ids are ignored by the UI until they get a renderer
block.mcp.visible=true
block.mcp.expanded=true
block.usage.visible=true
block.usage.expanded=true
# starting zoom, 0.7 to 2.0; the in-app zoom buttons write this value back
zoom=1.00
interval_secs=30
